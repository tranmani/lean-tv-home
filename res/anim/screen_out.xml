<?xml version="1.0" encoding="utf-8"?>
<!-- A screen closing: it grows a little and fades away. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="260" />
    <scale android:fromXScale="1" android:toXScale="1.06" android:fromYScale="1" android:toYScale="1.06"
        android:pivotX="50%" android:pivotY="50%" android:duration="380" />
</set>
