<?xml version="1.0" encoding="utf-8"?>
<!-- Home receding behind a screen that opens over it. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <scale android:fromXScale="1" android:toXScale="0.94" android:fromYScale="1" android:toYScale="0.94"
        android:pivotX="50%" android:pivotY="50%" android:duration="420" />
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="420" />
</set>
