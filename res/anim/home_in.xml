<?xml version="1.0" encoding="utf-8"?>
<!-- Home coming back as a screen closes. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <scale android:fromXScale="0.94" android:toXScale="1" android:fromYScale="0.94" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="420" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="300" />
</set>
