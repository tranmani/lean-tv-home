<?xml version="1.0" encoding="utf-8"?>
<!-- A screen opening from home: fades in while settling from slightly larger, as on tvOS. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="300" />
    <scale android:fromXScale="1.06" android:toXScale="1" android:fromYScale="1.06" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="420" />
</set>
